#!/bin/sh
set -eu

if [ -n "${BWS_FIXTURE_FAILURES:-}" ]; then
  : "${BWS_FIXTURE_COUNTER:?BWS_FIXTURE_COUNTER is required for retry tests}"
  attempt=0
  if [ -f "$BWS_FIXTURE_COUNTER" ]; then
    attempt="$(cat "$BWS_FIXTURE_COUNTER")"
  fi
  attempt=$((attempt + 1))
  printf '%s\n' "$attempt" >"$BWS_FIXTURE_COUNTER"
  if [ "$attempt" -le "$BWS_FIXTURE_FAILURES" ]; then
    printf 'Fixture transport failure\n' >&2
    exit 1
  fi
fi

if [ "${BWS_FIXTURE_DUPLICATE:-}" = '1' ]; then
  printf '%s\n' \
    '[{"key":"RAW_SECRET","value":"first"},{"key":"RAW_SECRET","value":"second"}]'
  exit 0
fi

printf '%s\n' \
  '[{"key":"RAW_SECRET","value":"value with spaces and $dollar"},{"key":"TOKEN_SECRET","value":"token-value"}]'
